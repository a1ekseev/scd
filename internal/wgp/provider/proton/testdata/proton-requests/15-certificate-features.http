POST /vpn/v1/certificate HTTP/1.1
Host: vpn-api.proton.me
x-pm-appversion: linux-vpn-gui@5.8.11+{{arch}}
User-Agent: ProtonVPN/5.8.11 (Linux; ubuntu/26.04)
x-pm-uid: {{uid}}
Authorization: Bearer {{new_access_token}}
x-pm-timezone: Europe/Istanbul
Accept: */*
Accept-Encoding: gzip, deflate, zstd
Content-Length: {{len}}
Content-Type: application/json

{"ClientPublicKey": "{{client_public_key_pem}}", "Duration": "10080 min", "Features": {"RandomNAT": false, "SplitTCP": false, "PortForwarding": true, "NetShieldLevel": 2}}