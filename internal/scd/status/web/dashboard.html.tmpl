<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Subscription Control Daemon Status</title>
  <style>
{{.CSS}}
  </style>
</head>
<body>
  <main>
    <h1>Subscription Control Daemon Status</h1>
    {{if .Instances}}<nav class="instance-tabs" role="tablist" aria-label="Instances">
{{- range $i, $in := .Instances}}{{if $i}}
{{end}}<button
  type="button"
  class="instance-tab{{if eq $i 0}} is-active{{end}}"
  id="instance-tab-{{$i}}"
  role="tab"
  aria-selected="{{if eq $i 0}}true{{else}}false{{end}}"
  aria-controls="instance-panel-{{$i}}"
  tabindex="{{if eq $i 0}}0{{else}}-1{{end}}"
>{{$in.ID}}</button>{{end}}</nav>{{end}}
    {{range $i, $in := .Instances}}{{if $i}}
{{end}}<section
  class="instance-panel"
  id="instance-panel-{{$i}}"
  role="tabpanel"
  aria-labelledby="instance-tab-{{$i}}"
  tabindex="0"{{if $i}} hidden{{end}}
>
  <div class="instance-head"><div><h2>{{$in.ID}}</h2><p>{{$in.Source}} · {{with $in.UpdatedAt}}Updated <time datetime="{{.}}">{{.}}</time>{{else}}{{$in.Freshness}}{{end}}</p></div></div>
  {{if $in.Snapshot}}{{template "wgp" $in.Snapshot}}{{template "subscriptions" $in.Snapshot}}{{else}}<section class="subscription-card"><p class="empty-state">No snapshot available.</p></section>{{end}}
</section>
{{- else}}<section class="subscription-card"><div class="subscription-head"><h2>No subscriptions</h2></div></section>{{end}}
  </main>
  <script>
{{.JS}}
  </script>
</body>
</html>
{{- define "subscriptions"}}{{$captured := .CapturedAt}}{{range $i, $s := .Subscriptions}}{{if $i}}
{{end}}<section class="subscription-card">
  <div class="subscription-head">
    <h2>{{$s.SubscriptionID}}</h2>
  </div>
  {{range $j, $t := $s.Targets}}{{if $j}}
{{end}}{{template "target" (targetCard $t $captured)}}{{end}}
</section>
{{- end}}{{end}}
{{- define "target"}}<section class="target-card">
  <div class="target-head">
    <div>
      <h3>{{.Address}}</h3>
      <p>{{.Summary}}</p>
    </div>
  </div>
  {{- range .Groups}}
  <section class="bal-group">
    <header class="bal-head state-{{.Class}}">
      <div class="node-orb" aria-hidden="true"></div>
      <div class="node-main">
        <div class="node-kicker">Balancer</div>
        {{if or .Title .Badges}}<div class="bal-title">{{with .Title}}<h4>{{.}}</h4>{{end}}{{range .Badges}}<span class="source-badge {{sourceColor .}}">{{.}}</span>{{end}}</div>{{end}}
        <dl class="kv">
          {{- range .Rows}}
          <dt>{{.Label}}</dt><dd>
            {{- range .Metrics}}
            {{template "metric" .}}
            {{- end}}
          </dd>
          {{- end}}
        </dl>
      </div>
    </header>
    {{- with .Summary}}
    <p class="group-summary">{{.}}</p>{{end}}
    <div class="nodes-grid">
      {{range $i, $tn := .Tunnels}}{{if $i}}
{{end}}{{template "tunnel" $tn}}{{else}}<p class="empty-state">{{.Empty}}</p>{{end}}
    </div>
  </section>
  {{- end}}
</section>
{{- end}}
{{- define "tunnel"}}<article class="node-card state-{{stateClass .State}}{{if .Selected}} is-selected{{end}}">
  <div class="node-orb" aria-hidden="true"></div>
  <div class="node-main">
    <div class="node-head"><div class="node-title" title="{{.DisplayName}}">{{.DisplayName}}</div>{{with .SourceID}}<span class="source-badge {{sourceColor .}}">{{.}}</span>{{end}}</div>
    <div class="node-meta">{{with .Badge}}<span class="node-badge">{{.}}</span>{{end}}{{.Meta}}</div>
    <div class="node-metrics">
      {{template "metric" (metric "State" .State)}}
      {{template "metric" .Probe}}
      {{template "metric" (metric "Balancer" (formatBalancerStatus .Balanced))}}
      {{- with .Observatory}}
      {{template "metric" .}}
      {{- end}}
      {{- if .FailuresInRow}}
      {{template "metric" (metric "Failures" (failures .FailuresInRow))}}
      {{- end}}
      {{- with .Paused}}
      {{template "metric" .}}
      {{- end}}
    </div>
  </div>
</article>
{{- end}}
{{- define "wgp"}}{{with wgpCards .}}<section class="subscription-card">
  <div class="subscription-head">
    <h2>wgp</h2>
  </div>
  <div class="cards-grid">
  {{- range .}}
  <article class="balancer-card state-{{.Class}}">
    <div class="node-orb" aria-hidden="true"></div>
    <div class="node-main">
      <div class="node-kicker">{{.Kicker}}</div>
      <div class="node-title">{{.Title}}</div>
      <div class="node-metrics">
        {{- range .Metrics}}
        {{template "metric" .}}
        {{- end}}
      </div>
    </div>
  </article>
  {{- end}}
  </div>
</section>
{{end}}{{end}}
{{- define "metric"}}<span class="metric{{metricClass .Label .Value}}{{.Class}}"{{with .Title}} title="{{.}}"{{end}}><span class="metric-label">{{.Label}}</span><span class="metric-value">{{.Value}}{{with .Time}}<time datetime="{{.}}">{{.}}</time>{{end}}{{.After}}</span></span>{{end}}
