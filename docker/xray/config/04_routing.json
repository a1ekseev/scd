{
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "ruleTag": "chain-vless",
        "inboundTag": [
          "chain-vless"
        ],
        "balancerTag": "x-balancer"
      },
      {
        "ruleTag": "direct",
        "inboundTag": [
          "socks-proxy",
          "wg-proxy"
        ],
        "ip": [
          "geoip:ru"
        ],
        "outboundTag": "direct"
      },
      {
        "ruleTag": "x-balancer",
        "inboundTag": [
          "socks-proxy",
          "wg-proxy"
        ],
        "ip": [
          "geoip:!ru"
        ],
        "balancerTag": "x-balancer"
      }
    ],
    "balancers": [
      {
        "tag": "x-balancer",
        "selector": [
          "x-observe-vless-"
        ],
        "strategy": {
          "type": "leastPing"
        }
      },
      {
        "tag": "x-wg-balancer",
        "selector": [
          "x-observe-wg-"
        ],
        "strategy": {
          "type": "leastPing"
        }
      },
      {
        "tag": "x-mq-balancer",
        "selector": [
          "x-observe-mq-"
        ],
        "strategy": {
          "type": "leastPing"
        }
      }
    ]
  }
}
