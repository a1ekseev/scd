{
  "subscriptions": [
    {
      "id": "s1",
      "enabled": true,
      "sources": [
        {
          "id": "vless",
          "type": "vless",
          "input": "testdata/reference/scd/print-config/sub.txt",
          "enabled": true,
          "format": "auto",
          "fetchTimeoutMs": 5000,
          "allowInsecure": "deny",
          "maxInputBytes": 67108864
        }
      ],
      "target": {
        "address": "127.0.0.1:8080",
        "timeoutMs": 5000,
        "fixedOutbounds": [],
        "fixedInbounds": [],
        "fixedRouting": [],
        "visionUdp443Override": false,
        "monitor": {
          "enabled": false,
          "maxParallel": 10,
          "retry": {
            "attempts": 1,
            "delayMs": 250
          }
        },
        "balancerMonitor": {
          "enabled": false,
          "retry": {
            "attempts": 1,
            "delayMs": 250
          },
          "remotePing": {
            "enabled": false,
            "timeoutMs": 5000,
            "viaSocks": false
          }
        },
        "balancerSelection": {
          "enabled": false,
          "observatory": true
        }
      }
    }
  ],
  "runtime": {
    "mode": "run-once"
  },
  "logging": {
    "level": "info",
    "format": "json"
  },
  "resources": {
    "outbounds": {
      "enabled": true
    },
    "inbounds": {
      "enabled": false
    },
    "routing": {
      "enabled": false
    }
  },
  "statusServer": {
    "enabled": true,
    "listen": "127.0.0.1:9090",
    "remoteInstances": [],
    "runtimeState": {
      "enabled": true,
      "includeRaw": false,
      "includeSecrets": false
    }
  }
}
