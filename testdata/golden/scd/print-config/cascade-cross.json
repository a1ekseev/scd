{
  "subscriptions": [
    {
      "id": "blanc-en",
      "enabled": true,
      "sources": [
        {
          "id": "blanc",
          "type": "vless",
          "input": "testdata/golden/scd/print-config/en.txt",
          "enabled": true,
          "format": "auto",
          "fetchTimeoutMs": 5000,
          "allowInsecure": "deny",
          "maxInputBytes": 67108864,
          "portRange": {
            "start": 20000,
            "end": 20009
          },
          "balancer": "pool-blanc"
        }
      ],
      "target": {
        "address": "127.0.0.1:8080",
        "timeoutMs": 5000,
        "fixedOutbounds": [],
        "fixedInbounds": [],
        "fixedRouting": [],
        "visionUdp443Override": false,
        "inboundSocks": {
          "listen": "127.0.0.1"
        },
        "monitor": {
          "enabled": false,
          "maxParallel": 10,
          "retry": {
            "attempts": 1,
            "delayMs": 250
          }
        },
        "balancers": [
          {
            "tag": "pool-blanc",
            "selection": {
              "enabled": true,
              "schedule": "*/15 * * * * *",
              "observatory": true
            }
          }
        ],
        "observatorySubjectSelectorPrefix": "obs-"
      }
    },
    {
      "id": "blanc-ru",
      "enabled": true,
      "sources": [
        {
          "id": "warp",
          "type": "vless",
          "input": "testdata/golden/scd/print-config/ru.txt",
          "enabled": true,
          "format": "auto",
          "fetchTimeoutMs": 5000,
          "allowInsecure": "deny",
          "maxInputBytes": 67108864,
          "portRange": {
            "start": 20100,
            "end": 20109
          },
          "balancer": "pool-vpn",
          "dependsOn": [
            {
              "subscription": "blanc-en",
              "balancer": "pool-blanc",
              "health": "balancer",
              "recoverGraceSeconds": 240
            }
          ]
        },
        {
          "id": "proton",
          "type": "vless",
          "input": "testdata/golden/scd/print-config/ru2.txt",
          "enabled": true,
          "format": "auto",
          "fetchTimeoutMs": 5000,
          "allowInsecure": "deny",
          "maxInputBytes": 67108864,
          "portRange": {
            "start": 20110,
            "end": 20119
          },
          "balancer": "pool-p"
        }
      ],
      "target": {
        "address": "127.0.0.1:8081",
        "timeoutMs": 5000,
        "fixedOutbounds": [],
        "fixedInbounds": [],
        "fixedRouting": [],
        "visionUdp443Override": false,
        "inboundSocks": {
          "listen": "127.0.0.1"
        },
        "monitor": {
          "enabled": false,
          "maxParallel": 10,
          "retry": {
            "attempts": 1,
            "delayMs": 250
          }
        },
        "balancers": [
          {
            "tag": "pool-vpn",
            "selection": {
              "enabled": true,
              "schedule": "*/15 * * * * *",
              "observatory": true
            }
          },
          {
            "tag": "pool-p",
            "selection": {
              "enabled": true,
              "schedule": "*/15 * * * * *",
              "observatory": true
            }
          }
        ],
        "observatorySubjectSelectorPrefix": "obs-"
      }
    }
  ],
  "runtime": {
    "mode": "run-once"
  },
  "logging": {
    "level": "info",
    "format": "json"
  },
  "resources": {
    "outbounds": {
      "enabled": true
    },
    "inbounds": {
      "enabled": true
    },
    "routing": {
      "enabled": true
    }
  },
  "statusServer": {
    "enabled": true,
    "listen": "127.0.0.1:9090",
    "remoteInstances": [],
    "runtimeState": {
      "enabled": true,
      "includeRaw": false,
      "includeSecrets": false
    }
  }
}
